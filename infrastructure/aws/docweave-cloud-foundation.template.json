{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DocWeave cloud foundation: S3 document artifacts, SQS analysis queue, Lambda API and worker, API Gateway, CloudWatch Logs, and Bedrock invocation permissions.",
  "Parameters": {
    "StageName": {
      "Type": "String",
      "Default": "dev",
      "AllowedPattern": "^[a-z0-9-]{2,32}$",
      "Description": "Lowercase API stage name."
    },
    "LambdaCodeS3Bucket": {
      "Type": "String",
      "Default": "docweave-lambda-artifact-bucket-placeholder",
      "Description": "S3 bucket containing the packaged Lambda artifact. Replace during approved deployment."
    },
    "LambdaCodeS3Key": {
      "Type": "String",
      "Default": "docweave-cloud-api.zip",
      "Description": "S3 key for the packaged Lambda artifact. Replace during approved deployment."
    },
    "BedrockModelId": {
      "Type": "String",
      "Default": "eu.amazon.nova-2-lite-v1:0",
      "Description": "Amazon Bedrock model or inference profile used by the cloud runtime."
    },
    "CockroachDbSecretArn": {
      "Type": "String",
      "Default": "",
      "NoEcho": true,
      "Description": "Secrets Manager ARN for the CockroachDB runtime connection. The template does not create or reveal the secret."
    },
    "MaxUploadBytes": {
      "Type": "Number",
      "Default": 52428800,
      "MinValue": 1,
      "MaxValue": 104857600,
      "Description": "Maximum PDF upload size accepted by the pre-signing API."
    },
    "MaxBedrockDocumentBytes": {
      "Type": "Number",
      "Default": 4194304,
      "MinValue": 1,
      "MaxValue": 10485760,
      "Description": "Maximum PDF size the worker sends to Amazon Bedrock document analysis."
    }
  },
  "Conditions": {
    "HasCockroachDbSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CockroachDbSecretArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "DocumentArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteMultipartUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          },
          {
            "Key": "Purpose",
            "Value": "DocumentArtifactMemory"
          }
        ]
      }
    },
    "AnalysisDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          }
        ]
      }
    },
    "AnalysisQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 180,
        "MessageRetentionPeriod": 345600,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "AnalysisDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          }
        ]
      }
    },
    "CloudApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DocWeaveCloudRuntimePolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-*:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DocumentArtifactBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "DocumentArtifactBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes",
                    "sqs:ReceiveMessage",
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AnalysisQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          }
        ]
      }
    },
    "CloudApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 14
      }
    },
    "AnalysisWorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-analysis-worker"
        },
        "RetentionInDays": 14
      }
    },
    "CloudApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "CloudApiLogGroup",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "docweave_cloud_api.handler.api_handler",
        "Role": {
          "Fn::GetAtt": [
            "CloudApiRole",
            "Arn"
          ]
        },
        "Timeout": 20,
        "MemorySize": 512,
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeS3Bucket"
          },
          "S3Key": {
            "Ref": "LambdaCodeS3Key"
          }
        },
        "Environment": {
          "Variables": {
            "DOCWEAVE_DOCUMENT_BUCKET": {
              "Ref": "DocumentArtifactBucket"
            },
            "DOCWEAVE_ANALYSIS_QUEUE_URL": {
              "Ref": "AnalysisQueue"
            },
            "DOCWEAVE_BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "DOCWEAVE_COCKROACHDB_SECRET_ARN": {
              "Ref": "CockroachDbSecretArn"
            },
            "DOCWEAVE_DATABASE_URL": {
              "Fn::If": [
                "HasCockroachDbSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${CockroachDbSecretArn}:SecretString:database_url}}"
                },
                ""
              ]
            },
            "DOCWEAVE_MAX_UPLOAD_BYTES": {
              "Ref": "MaxUploadBytes"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          }
        ]
      }
    },
    "AnalysisWorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "AnalysisWorkerLogGroup",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-analysis-worker"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "docweave_cloud_api.handler.worker_handler",
        "Role": {
          "Fn::GetAtt": [
            "CloudApiRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 1024,
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeS3Bucket"
          },
          "S3Key": {
            "Ref": "LambdaCodeS3Key"
          }
        },
        "Environment": {
          "Variables": {
            "DOCWEAVE_DOCUMENT_BUCKET": {
              "Ref": "DocumentArtifactBucket"
            },
            "DOCWEAVE_ANALYSIS_QUEUE_URL": {
              "Ref": "AnalysisQueue"
            },
            "DOCWEAVE_BEDROCK_MODEL_ID": {
              "Ref": "BedrockModelId"
            },
            "DOCWEAVE_COCKROACHDB_SECRET_ARN": {
              "Ref": "CockroachDbSecretArn"
            },
            "DOCWEAVE_DATABASE_URL": {
              "Fn::If": [
                "HasCockroachDbSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${CockroachDbSecretArn}:SecretString:database_url}}"
                },
                ""
              ]
            },
            "DOCWEAVE_MAX_BEDROCK_DOCUMENT_BYTES": {
              "Ref": "MaxBedrockDocumentBytes"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DocWeave"
          }
        ]
      }
    },
    "AnalysisQueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "AnalysisQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "AnalysisWorkerFunction"
        },
        "BatchSize": 5,
        "MaximumBatchingWindowInSeconds": 5,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http-api"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowHeaders": [
            "content-type"
          ],
          "AllowMethods": [
            "GET",
            "POST"
          ],
          "AllowOrigins": [
            "http://localhost:3000",
            "http://localhost:5173"
          ],
          "MaxAge": 300
        },
        "Tags": {
          "Project": "DocWeave"
        }
      }
    },
    "HttpApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "CloudApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0"
      }
    },
    "HealthRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /health",
        "Target": {
          "Fn::Sub": "integrations/${HttpApiIntegration}"
        }
      }
    },
    "PresignRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /uploads/presign",
        "Target": {
          "Fn::Sub": "integrations/${HttpApiIntegration}"
        }
      }
    },
    "AnalysisJobRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /analysis-jobs",
        "Target": {
          "Fn::Sub": "integrations/${HttpApiIntegration}"
        }
      }
    },
    "AnalysisResultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /analysis-results/{job_id}",
        "Target": {
          "Fn::Sub": "integrations/${HttpApiIntegration}"
        }
      }
    },
    "HttpApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": {
          "Ref": "StageName"
        },
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        }
      }
    },
    "HttpApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "CloudApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*"
        }
      }
    }
  },
  "Outputs": {
    "DocumentArtifactBucketName": {
      "Value": {
        "Ref": "DocumentArtifactBucket"
      }
    },
    "AnalysisQueueUrl": {
      "Value": {
        "Ref": "AnalysisQueue"
      }
    },
    "CloudApiUrl": {
      "Value": {
        "Fn::Sub": "https://${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/${StageName}"
      }
    },
    "CloudServices": {
      "Value": "Amazon S3, Amazon SQS, AWS Lambda, Amazon API Gateway, Amazon CloudWatch Logs, Amazon Bedrock"
    }
  }
}
